# ========================================
# Betty Bot - Environment Variables
# ========================================
# IMPORTANT: Never commit your actual .env file to git!
# Copy this file to .env and fill in your actual values

# ========================================
# BETTY MODE
# ========================================
# Which version of Betty to run:
#   - "betting"        = Original NBA/NFL betting bot (legacy)
#   - "march_madness"  = March Madness survivor pool (new)
# Default: march_madness
BETTY_MODE=march_madness

# Slack Configuration
# Get these from: https://api.slack.com/apps (Your App > OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# Anthropic Claude API
# Get this from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Database (Supabase PostgreSQL)
# Get this from: Supabase Dashboard > Project Settings > Database
# Use the "Connection Pooling" URL for better performance
DATABASE_URL=postgresql://user:password@host.supabase.co:5432/postgres

# Server Configuration
NODE_ENV=development
PORT=3000

# ========================================
# BETTING MODE ONLY (Legacy Settings)
# ========================================
# These settings only apply when BETTY_MODE=betting

# Testing Mode
# Set to "true" for development (allows bet proposer to accept their own bets)
# Set to "false" for production (only opponent can accept bets)
# IMPORTANT: This MUST be "false" for production use
TESTING_MODE=false

# Personality Mode
# Set to "true" to enable Betty's sassy, confident, flirty personality
# Set to "false" for neutral, professional responses
# Personality mode uses additional Claude API calls for settlement messages
PERSONALITY_MODE=false

# ========================================
# MARCH MADNESS MODE ONLY (New Settings)
# ========================================
# These settings only apply when BETTY_MODE=march_madness

# Admin Console Password
# Used to access the admin web console at /admin
# IMPORTANT: Change this to a secure password in production!
ADMIN_PASSWORD=changeme-secure-password

# Main Slack Channel ID for March Madness announcements
# Get this by right-clicking your Slack channel > View channel details > Copy channel ID
# Format: C0123456789
SLACK_MAIN_CHANNEL_ID=C0123456789
